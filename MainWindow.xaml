<Window x:Class="Dalton_Trapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Dalton_Trapper.ViewModel"
        xmlns:Menu="clr-namespace:Dalton_Trapper.Utilities"
        mc:Ignorable="d"
        Title="TrappeApp"
        Height="890"
        Width="1550"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.DataContext>
        <vm:NavigationVM />
    </Window.DataContext>

    <Grid>

        <!--// Window Border //-->
        <Border Background="#212529"
                CornerRadius="20" />
        <Grid>
            <!--// Base Grid //-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!--// Navigation Panel //-->
            <Grid HorizontalAlignment="Left"
                  Width="230">
                <Border Background="#272B2F"
                        CornerRadius="20,0,0,20" />
                <StackPanel Height="500"
                            Width="228">

                    <!--// Home //-->
                    <Menu:Btn Style="{StaticResource BtnStyle}"
                              Command="{Binding HomeCommand}"
                              IsChecked="True">
                        <Grid>
                            <Image Source="Images/img_home.png"
                                   Style="{StaticResource Image_Style}" />
                            <TextBlock Text="Home"
                                       Style="{StaticResource Text_Style}" />
                        </Grid>
                    </Menu:Btn>

                    <!--// Projektering //-->
                    <Menu:Btn Style="{StaticResource BtnStyle}"
                              Command="{Binding ProjekteringCommand}">
                        <Grid>
                            <Image Source="Images/img_projektering.png"
                                   Style="{StaticResource Image_Style}" />
                            <TextBlock Text="Projektering"
                                       Style="{StaticResource Text_Style}" />
                        </Grid>
                    </Menu:Btn>

                    <!--// FEM-Design //-->
                    <Menu:Btn Style="{StaticResource BtnStyle}"
                              Command="{Binding FemdesignCommand}">
                        <Grid>
                            <Image Source="Images/img_femdesign.png"
                                   Style="{StaticResource Image_Style}" />
                            <TextBlock Text="FEM-Design"
                                       Style="{StaticResource Text_Style}" />
                        </Grid>
                    </Menu:Btn>

                    <!--// Test page //-->
                    <Menu:Btn Style="{StaticResource BtnStyle}"
                              Command="{Binding TestPageCommand}" Visibility="{Binding TestPageVisibility}">
                        <Grid>
                            <Image Source="Images/img_testpage.png"
                                   Style="{StaticResource Image_Style}" />
                            <TextBlock Text="Test-side"
                                       Style="{StaticResource Text_Style}" />
                        </Grid>
                    </Menu:Btn>
                </StackPanel>
                <TextBlock x:Name="AppVersion" Style="{StaticResource Text_Style_Bottom}" VerticalAlignment="Bottom"/>
            </Grid>
            <Grid Grid.Column="1">
                <ContentControl x:Name="Pages"
                                Content="{Binding CurrentView}" />
            </Grid>
        </Grid>
        <Button x:Name="CloseApp"
                Style="{StaticResource ExitApp}"
                Click="CloseApp_Click" />
        <Button x:Name="MinimizeApp"
                Style="{StaticResource MinimizeApp}"
                Click="MinimizeApp_Click" />
    </Grid>
</Window>