<UserControl x:Class="Dalton_Trapper.UserControls.InputBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             Height="Auto" Width="auto">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LabelWidth, ElementName=Root}" />
            <!-- Label -->
            <ColumnDefinition Width="{Binding InputWidth, ElementName=Root}" />
            <!-- TextBox -->
        </Grid.ColumnDefinitions>

        <!-- Label -->
        <TextBlock Text="{Binding Label, ElementName=Root}" 
                   FontSize="16"
                   Foreground="#DBDBDB"
                   VerticalAlignment="Center" />

        <!-- TextBox -->
        <TextBox Grid.Column="1"
                 Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Background="#444554"
                 Foreground="#DBDBDB"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                 Margin="3"
                 Padding="6"
                 FontSize="16"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Left"
                 VerticalContentAlignment="Center"
                 Height="35">
            
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="Border" Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                  Focusable="False" 
                                                  HorizontalScrollBarVisibility="Hidden" 
                                                  VerticalScrollBarVisibility="Hidden" 
                                                  Margin="5,0,0,0"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>
    </Grid>
</UserControl>
